# bulk — Environment Variables
#
# Copy this file to `.env` and fill in your Supabase project values.
# These are "EXPO_PUBLIC_" prefixed so they are available in the client bundle.
# The anon key is safe to ship in a client app (it is gated by RLS policies),
# but never put your service_role key here.
#
# The app runs fully in local/mock mode if these are left blank — Supabase is
# only required once you want real cloud storage + hosted public photo URLs.

EXPO_PUBLIC_SUPABASE_URL=your_supabase_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: the public host used to build photo URLs in the eBay CSV.
# Leave blank to derive it automatically from EXPO_PUBLIC_SUPABASE_URL.
EXPO_PUBLIC_PHOTO_PUBLIC_HOST=


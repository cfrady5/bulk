# The Card API (server-side only — never expose to the browser)
CARD_API_KEY=tca_your_key_here

# Supabase (optional — app runs in on-device Local Mode without these)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# PSA cert lookup (optional). PSA_API_KEY works as an alias.
# Register at https://www.psacard.com/publicapi — note PSA must approve the
# account before cert endpoints stop returning 403.
# PSA_API_TOKEN=

{
  "expo": {
    "name": "bulk",
    "slug": "bulk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "cardsnap",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0B0D"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cardsnap.listings",
      "infoPlist": {
        "NSCameraUsageDescription": "bulk uses the camera to photograph your sports cards for listings.",
        "NSPhotoLibraryUsageDescription": "bulk needs photo library access to attach card photos to listings.",
        "NSPhotoLibraryAddUsageDescription": "bulk can save exported card photos to your library."
      }
    },
    "android": {
      "package": "com.cardsnap.listings",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0B0D"
      },
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE", "WRITE_EXTERNAL_STORAGE"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow bulk to access your camera to photograph cards."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow bulk to access your photos to attach card images."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
